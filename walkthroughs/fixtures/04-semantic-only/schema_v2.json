{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proj v2",
  "description": "v2: proj:transform coefficients are anchored at the upper-left PIXEL CORNER.",
  "type": "object",
  "required": ["proj:code", "proj:transform"],
  "properties": {
    "proj:code": { "type": "string" },
    "proj:transform": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 6,
      "maxItems": 6
    }
  },
  "additionalProperties": true
}
